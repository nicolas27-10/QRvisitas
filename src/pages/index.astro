		min-height: 100dvh;
		display: grid;
		place-items: center;
		padding: 2rem;
		background-color: #eef1f5;
		background-image: linear-gradient(180deg, #f5f7fa 0%, #e4e9f0 100%);
		color: #1e3a5f;
		position: relative;
		font-family: 'Segoe UI', Arial, sans-serif;
	}

