---
import Layout from '../layouts/Layout.astro';

---


<Layout title="Entrada autorizada - Robbie Williams">
	<main class="page">
		<section class="card">
			<!-- Logo del evento -->
			<div class="event-logo">
				<h1 class="main-title">
					<span class="rap-text">Robbie Williams</span>
					<span class="estadio-text">
						Estadio Bicentenario de La Florida.
					</span>
				</h1>
				<div class="event-date">27 de Septiembre de 2026</div>
			</div>
			
			<h2>Entrada autorizada para residentes y visitas</h2>
			<p>
				<strong>Entrada autorizada por residente</strong> de la <strong>Junta de Vecinos Nro. 17 y Villa Palermo - La Florida</strong>.
			</p>
			<p>
				Válido solo el <strong>27 de Septiembre de 2026</strong>.
			</p>
			<p class="note">Muestre este comprobante junto a su identificación al ser requerido.</p>
		</section>

		<footer class="footer">
			<p>Robbie Williams · La Florida · 2026</p>
			<p>Junta de Vecinos Nro. 17 La Florida</p>	
		</footer>
	</main>
</Layout>

