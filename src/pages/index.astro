		min-height: 100dvh;
		display: grid;
		place-items: center;
		padding: 2rem;
		background-color: #04361f;
		background-image:
			repeating-linear-gradient(90deg, rgba(255,255,255,0.045) 0 70px, rgba(255,255,255,0) 70px 140px),
			radial-gradient(circle at 50% 12%, rgba(98,196,232,0.25), rgba(98,196,232,0) 55%),
			linear-gradient(170deg, #0b7f44 0%, #056134 40%, #022d18 100%);
		color: #ffffff;
		position: relative;
		font-family: 'Arial', sans-serif;
	}

