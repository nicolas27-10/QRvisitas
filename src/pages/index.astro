	.card {
		max-width: 720px;
		width: 100%;
		background: #ffffff;
		border-radius: 8px;
		box-shadow: 0 2px 12px rgba(30,58,95,0.12);
		padding: 2.5rem 2rem 2rem;
		text-align: center;
		border: 1px solid #d3dae4;
		position: relative;
		overflow: hidden;
	}

	.card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 6px;
		background: #1e3a5f;
	}

	.event-logo {
		margin-bottom: 1.75rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid #e3e8ee;
	}

	.main-title {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.rap-text {
		font-size: 2.4rem;
		font-weight: 700;
		color: #1e3a5f;
		line-height: 1.15;
		letter-spacing: -0.01em;
		position: relative;
	}

	.estadio-text {
		font-size: 0.95rem;
		font-weight: 600;
		color: #6b7a8d;
		font-style: normal;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.event-date {
		display: inline-block;
		font-size: 1.05rem;
		font-weight: 600;
		color: #ffffff;
		margin-top: 1.1rem;
		padding: 0.5rem 1.4rem;
		border-radius: 4px;
		background: #1e3a5f;
		letter-spacing: 0.02em;
	}

	h2 {
		margin: 0 0 1rem;
		font-size: 1.35rem;
		font-weight: 600;
		color: #1e3a5f;
		letter-spacing: 0.01em;
	}

	p {
		margin: 0.4rem 0;
		font-size: 1rem;
		line-height: 1.55;
		color: #3d4b5c;
	}

	strong {
		font-weight: 700;
		color: #1e3a5f;
	}

	.note {
		color: #6b7a8d;
		font-size: 0.9rem;
		margin-top: 1.25rem;
		padding-top: 1rem;
		border-top: 1px solid #e3e8ee;
	}

	.footer {
		text-align: center;
		margin-top: 1.25rem;
		color: #6b7a8d;
		font-size: 0.82rem;
		line-height: 1.5;
	}

	@media (max-width: 768px) {
		.page {
			padding: 1rem;
		}

		.card {
			padding: 2rem 1.25rem 1.5rem;
		}

		.rap-text {
			font-size: 1.9rem;
		}

		.estadio-text {
			font-size: 0.8rem;
		}

		h2 {
			font-size: 1.2rem;
		}

		p {
			font-size: 0.95rem;
		}
	}
</style>
