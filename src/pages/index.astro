---
import Layout from '../layouts/Layout.astro';

---


<Layout title="Entrada autorizada - Audax Italiano VS Olimpia">
	<main class="page">
		<section class="card">
			<!-- Logo del evento -->
			<div class="event-logo">
				<h1 class="main-title"> 
					<span class="rap-text">Audax Italiano VS Olimpia</span>
					<span class="estadio-text">
						Fútbol profesional internacional (CONMEBOL Sudamericana).
					</span>
				</h1>
				<div class="event-date">08 de Abril de 2026</div>
			</div>
			
			<h2>Entrada autorizada para residentes y visitas</h2>
			<p>
				<strong>Entrada autorizada por residente</strong> de la <strong>Junta de Vecinos Nro. 17 y Villa Palermo - La Florida</strong>.
			</p>
			<p>
				Válido solo el <strong>08 de Abril de 2026</strong>.
			</p>
			<p class="note">Muestre este comprobante junto a su identificación al ser requerido.</p>
		</section>

		<footer class="footer">
			<p>Audax Italiano VS Olimpia · La Florida · 2026</p>
			<p>Junta de Vecinos Nro. 17 La Florida</p>
		</footer>
	</main>
</Layout>

