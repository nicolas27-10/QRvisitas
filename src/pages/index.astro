---
import Layout from '../layouts/Layout.astro';

---


<Layout title="Entrada autorizada - La Roja Femenina">
	<main class="page">
		<section class="card">
			<!-- Logo del evento -->
			<div class="event-logo">
				<h1 class="main-title">
					<span class="rap-text">LA ROJA</span>
					<span class="estadio-text">FEMENINA</span>
				</h1>
				<div class="event-date">06-12-25</div>
			</div>
			
			<h2>Entrada autorizada</h2>
			<p>
				<strong>Entrada autorizada por residente</strong> de la <strong>Junta de Vecinos Nro. 17 La Florida</strong>.
			</p>
			<p>
				Válido solo el <strong>06 de Diciembre de 2025</strong>.
			</p>
			<p class="note">Muestre este comprobante junto a su identificación al ser requerido.</p>
		</section>

		<footer class="footer">
			<p>LA ROJA FEMENINA · La Florida · 2025</p>
			<p>Junta de Vecinos Nro. 17 La Florida</p>
		</footer>
	</main>
</Layout>

