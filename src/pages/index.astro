	.card {
		max-width: 720px;
		width: 100%;
		background: linear-gradient(180deg, rgba(7,66,37,0.94) 0%, rgba(2,35,20,0.96) 100%);
		border-radius: 20px;
		box-shadow: 0 8px 40px rgba(0,0,0,0.45), inset 0 0 0 1px rgba(98,196,232,0.25);
		padding: 2rem;
		text-align: center;
		border: 3px solid #ffffff;
		position: relative;
		overflow: hidden;
	}

	.card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 7px;
		background: linear-gradient(90deg, #00a651 0%, #ffffff 50%, #62c4e8 100%);
	}

	.event-logo {
		margin-bottom: 1.5rem;
	}

	.main-title {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.rap-text {
		font-size: 3.5rem;
		font-weight: 700;
		color: #ffffff;
		text-transform: uppercase;
		line-height: 1.05;
		text-shadow: 0 3px 0 rgba(0,0,0,0.45);
		letter-spacing: 0.02em;
		position: relative;
	}

	.estadio-text {
		font-size: 1.6rem;
		font-weight: 600;
		color: #8ddcf5;
		text-shadow: 1px 1px 2px rgba(0,0,0,0.45);
		font-style: normal;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.event-date {
		display: inline-block;
		font-size: 1.2rem;
		font-weight: bold;
		color: #ffffff;
		margin-top: 0.9rem;
		padding: 0.4rem 1.2rem;
		border-radius: 999px;
		background: rgba(0,166,81,0.45);
		border: 1px solid rgba(255,255,255,0.55);
		text-shadow: 1px 1px 0 rgba(0,0,0,0.4);
	}

	h2 {
		margin: 0.25rem 0 0.75rem;
		font-size: 1.9rem;
		color: #ffffff;
		text-shadow: 1px 1px 0 rgba(0,0,0,0.45);
	}

	p { 
		margin: 0.25rem 0; 
		font-size: 1.05rem; 
		color: #eafff3;
		text-shadow: 1px 1px 0 rgba(0,0,0,0.35);
	}

	strong { 
		font-weight: 700; 
		color: #ffffff;
	}

	.note { 
		color: #8ddcf5; 
		font-size: 0.95rem; 
		margin-top: 0.75rem; 
		opacity: 0.95;
	}

	.footer { 
		text-align: center; 
		margin-top: 1rem; 
		color: #ffffff; 
		font-size: 0.9rem; 
		text-shadow: 1px 1px 0 rgba(0,0,0,0.45);
		opacity: 0.9;
	}

	@media (max-width: 768px) {
		.page {
			padding: 1rem;
		}

		.card {
			padding: 1.5rem;
		}

		.rap-text {
			font-size: 2.5rem;
		}

		.estadio-text {
			font-size: 1.3rem;
		}

		h2 {
			font-size: 1.6rem;
		}

		p {
			font-size: 1rem;
		}
	}
</style>
